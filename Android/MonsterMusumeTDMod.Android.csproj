<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MonsterMusumeTDMod.Android</AssemblyName>
    <Version>0.1.118</Version>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);ANDROID</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AndroidWorkspace Condition="'$(AndroidWorkspace)' == ''">$(MSBuildThisFileDirectory)..\work</AndroidWorkspace>
    <LoaderDir>$(AndroidWorkspace)\Loader</LoaderDir>
    <InteropDir>$(AndroidWorkspace)\Interop</InteropDir>
    <OutputPath>$(AndroidWorkspace)\Build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Plugin.cs;Configuration.cs;AndroidPaths.cs;Aliases.cs" />
    <Compile Include="..\Core\ModConfig.cs;..\Services\*.cs;..\Patches\*.cs" />
    <Reference Include="$(InteropDir)\*.dll" Private="false" />
    <Reference Include="MelonLoader" HintPath="$(LoaderDir)\MelonLoader.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(LoaderDir)\0Harmony.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(LoaderDir)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="Il2CppInterop.Common" HintPath="$(LoaderDir)\Il2CppInterop.Common.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckAndroidReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(InteropDir)\Assembly-CSharp.dll')" Text="Generate Android Interop assemblies with Prepare.ps1 first." />
    <Error Condition="!Exists('$(LoaderDir)\MelonLoader.dll')" Text="Extract the matching LemonLoader runtime with Prepare.ps1 first." />
  </Target>
</Project>
